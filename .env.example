# El archivo .env no se sube a GitHub

# Base de datos (valores de DESARROLLO; en produccion se usan otros, nuevos y distintos)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=acompaname_db
DB_USER=acompaname_user
DB_PASSWORD=acompaname_pass
DB_ROOT_PASSWORD=root

# Variables que lee la aplicacion (en produccion se definen en el hosting, no aqui).
# Son solo ejemplos: no uses estos valores en produccion.
# En produccion tambien hace falta SPRING_PROFILES_ACTIVE=prod: asi DB_USER, DB_PASSWORD y
# JWT_SECRET son obligatorias y la aplicacion no arranca si falta alguna.
JWT_SECRET=cambia-esto-por-una-clave-larga-de-32-caracteres-o-mas
JWT_EXPIRATION_MINUTES=120
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambia-esta-contrasena
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
# CAPTCHA (Cloudflare Turnstile). Desactivado por defecto; en producción va activado
CAPTCHA_ENABLED=false
CAPTCHA_SECRET=
FOTO_MAX_BYTES=300000
