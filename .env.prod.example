# Variables de PRODUCCIÓN para docker-compose.prod.yml. Se copia a ".env" EN EL SERVIDOR y se rellena.
# El archivo ".env" NUNCA se sube a GitHub. Todos los valores de aquí son ejemplos: ninguno sirve tal cual.
# Guía: docs/deployment.md

# --- Dominio ---
# Dominio de la API (api.midominio.es): Caddy pide el certificado HTTPS solo, y el dominio tiene que
# apuntar a la IP del servidor. Para probar en local o por IP, sin HTTPS: API_DOMAIN=:80
API_DOMAIN=api.midominio.es
# Puertos publicados (para probar en local si el 80 o el 443 están ocupados)
#HTTP_PORT=80
#HTTPS_PORT=443

# --- Base de datos (valores NUEVOS, distintos a los de desarrollo; largos y aleatorios) ---
# Generar uno: openssl rand -base64 24
DB_NAME=acompaname_db
DB_USER=acompaname_user
DB_PASSWORD=cambia-esto
DB_ROOT_PASSWORD=cambia-esto-tambien

# --- Seguridad ---
# Generar: openssl rand -base64 48   (si se cambia, se cierran todas las sesiones abiertas)
JWT_SECRET=cambia-esto
# Cifra en la base de datos la dirección secreta de los calendarios vinculados. Generar: openssl rand -base64 32
# Si se pierde o se cambia, los calendarios vinculados dejan de leerse y hay que vincularlos otra vez
CALENDARIO_CLAVE=cambia-esto

# --- Front ---
# Dirección del front (Cloudflare Pages), sin barra final. CORS_ORIGINS admite varias separadas por coma
CORS_ORIGINS=https://acompaname.es
FRONTEND_URL=https://acompaname.es

# --- Correo (SMTP del proveedor elegido) ---
MAIL_FROM=no-reply@acompaname.es
MAIL_HOST=smtp.proveedor.com
MAIL_PORT=587
MAIL_USER=cambia-esto
MAIL_PASSWORD=cambia-esto

# --- CAPTCHA (Cloudflare Turnstile) ---
# Activo por defecto. CAPTCHA_SECRET es la clave SECRETA de Turnstile (la del front es otra, y es pública)
CAPTCHA_ENABLED=true
CAPTCHA_SECRET=cambia-esto

# --- Administración ---
# La app crea esta cuenta de administración al arrancar si no existe. Cambia la contraseña desde la web
# después del primer acceso y quita ADMIN_PASSWORD del .env
ADMIN_EMAIL=admin@acompaname.es
ADMIN_PASSWORD=cambia-esto

# --- Opcionales ---
# Memoria máxima del back (la JVM usa el 75 % de esto). Con un servidor de 1 GB, 512m
#BACKEND_MEM_LIMIT=768m
# Verificar con la ubicación si la persona cuidadora está en el lugar (manda la dirección a Nominatim).
# Apagado hasta que la política de privacidad lo explique
#FICHAJE_VERIFICAR_LUGAR=false
